# 이 파일을 .env 로 복사한 뒤 값을 채우세요:  copy .env.example .env
# 로봇 IP (Unitree Go 앱 → 네트워크 화면의 wlan0)
UNITREE_ROBOT_IP=192.168.x.x
# 펌웨어 1.1.15+ 로봇별 AES-128 키 (32자리 16진수). unitree_ui 계정 화면에서 확인
UNITREE_AES_128_KEY=
# (선택) Claude API 키 — 말로 시키기(LLM) 기능용. platform.claude.com에서 발급
ANTHROPIC_API_KEY=
# (선택) 실제 대시보드 비밀번호. 비우면 잠금 없음 (기본)
DASHBOARD_PASSWORD=
